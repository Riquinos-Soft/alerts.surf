# Copy to /opt/alerts.surf/.env, owned by the deploy user, chmod 600.
# Generate the password with openssl rand -hex 32 (URL-safe for DATABASE_URL).
POSTGRES_DB=alerts_surf
POSTGRES_USER=alerts_surf
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Before DNS cutover use http://198.244.233.153; afterwards alerts.surf.
SITE_ADDRESS=alerts.surf
HTTP_PORT=80
HTTPS_PORT=443
